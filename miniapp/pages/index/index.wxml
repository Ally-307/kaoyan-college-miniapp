<!-- 首页：搜索 + 院校列表 -->
<view class="page">
  <!-- 头部区域 -->
  <view class="hero">
    <view class="hero-content">
      <text class="hero-title">考研院校通</text>
      <text class="hero-subtitle">一键查询目标院校考研信息</text>
    </view>

    <!-- 搜索栏 -->
    <view class="search-box">
      <view class="search-bar">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜索院校名称、省份..."
          placeholder-style="color: #94A3B8; font-size: 28rpx;"
          value="{{keyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          focus="{{false}}"
        />
        <view class="search-clear {{keyword ? 'show' : ''}}" bindtap="onSearchClear">
          <text class="clear-icon">✕</text>
        </view>
      </view>
    </view>

    <!-- 快捷筛选入口 -->
    <view class="filter-trigger" bindtap="toggleFilter">
      <text class="filter-trigger-text">筛选</text>
      <text class="filter-arrow {{showFilter ? 'up' : ''}}">▾</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel {{showFilter ? 'active' : ''}}">
    <!-- 院校类型 -->
    <view class="filter-section">
      <text class="filter-label">院校类型</text>
      <view class="filter-tags">
        <view
          class="tag-region {{selectedTypes.indexOf('985') > -1 ? 'active' : ''}}"
          data-type="985"
          bindtap="onSelectType"
        >985</view>
        <view
          class="tag-region {{selectedTypes.indexOf('211') > -1 ? 'active' : ''}}"
          data-type="211"
          bindtap="onSelectType"
        >211</view>
        <view
          class="tag-region {{selectedTypes.indexOf('双一流') > -1 ? 'active' : ''}}"
          data-type="双一流"
          bindtap="onSelectType"
        >双一流</view>
      </view>
    </view>

    <!-- 地区 -->
    <view class="filter-section">
      <text class="filter-label">所在地区</text>
      <view class="filter-tags">
        <view wx:for="{{filterOptions.regions}}" wx:key="*this">
          <view
            class="tag-region {{selectedRegions.indexOf(item) > -1 ? 'active' : ''}}"
            data-region="{{item}}"
            bindtap="onSelectRegion"
          >{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="filter-actions" wx:if="{{selectedTypes.length > 0 || selectedRegions.length > 0}}">
      <view class="clear-btn" bindtap="clearFilters">清除筛选</view>
    </view>
  </view>

  <!-- 主要内容区 -->
  <view class="main-content">
    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="loading-mask">
      <view class="loading-spinner"></view>
    </view>

    <!-- 搜索无结果 -->
    <view wx:elif="{{hasSearched && filteredSchools.length === 0}}" class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-text">未找到匹配的院校，试试其他关键词</text>
    </view>

    <!-- 搜索结果 -->
    <view wx:elif="{{hasSearched && filteredSchools.length > 0}}">
      <view class="result-count faint">共 {{total}} 所院校</view>
      <view class="school-list">
        <view
          wx:for="{{filteredSchools}}"
          wx:key="id"
          class="school-card fade-in"
          data-id="{{item.id}}"
          bindtap="onSchoolTap"
        >
          <view class="school-card-header">
            <text class="school-name">{{item.name}}</text>
            <view class="school-tags">
            <view wx:for="{{item.types}}" wx:key="*this" class="tag" style="{{item.style}}">{{item.label}}</view>
            </view>
            <text class="school-arrow">›</text>
          </view>
          <view class="school-meta">
            <text class="school-province">{{item.province}} · {{item.city}}</text>
            <text class="school-region">{{item.region}}</text>
          </view>
          <view class="school-intro text-ellipsis-2">{{item.intro}}</view>
          <view class="school-footer">
            <text class="school-majors-count">{{item.majorsCount}} 个招生专业</text>
          </view>
        </view>
      </view>
      <view wx:if="{{hasMore}}" style="text-align:center;padding:24rpx 0;color:#94A3B8;font-size:26rpx;">
        <text>{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
      </view>
    </view>

    <!-- 默认：热门院校推荐 -->
    <view wx:elif="{{!hasSearched}}">
      <view class="section-title">
        <view class="section-title-icon"></view>
        <text>热门院校</text>
      </view>
      <view class="hot-list">
        <view
          wx:for="{{hotSchools}}"
          wx:key="id"
          class="hot-card"
          data-id="{{item.id}}"
          bindtap="onHotSchoolTap"
        >
          <view class="hot-card-top">
            <text class="hot-name">{{item.name}}</text>
            <view class="hot-tags">
              <view wx:for="{{item.types.slice(0, 2)}}" wx:key="*this" class="tag" style="{{item.style}}">{{item.label}}</view>
            </view>
          </view>
          <text class="hot-province">{{item.province}} · {{item.city}}</text>
        </view>
      </view>

      <view class="section-title">
        <view class="section-title-icon"></view>
        <text>全国地区分布</text>
      </view>
      <view class="region-grid">
        <view
          wx:for="{{regionStats}}"
          wx:key="region"
          class="region-chip"
          data-region="{{item.region}}"
          bindtap="onSelectRegion"
        >
          <text class="region-name">{{item.region}}</text>
          <text class="region-count" wx:if="{{item.count > 0}}">{{item.count}}所</text>
          <text class="region-count" wx:else>暂无数据</text>
        </view>
      </view>
    </view>
  </view>
</view>
